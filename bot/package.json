{
  "name": "centerside",
  "version": "1.0.0",
  "private": true,
  "description": "CenterSide — Discord ticket bot with a server knowledge pack",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "selftest": "node scripts/selftest.js",
    "modaltest": "node scripts/modaltest.js",
    "autotest": "node scripts/autotest.js",
    "maptest": "node scripts/maptest.js",
    "bench": "node scripts/bench.js",
