# CenterSide bot
# Copy this file to `.env` and fill it in. Never commit the real .env.

DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# Optional: register slash commands to one guild instantly while developing.
# Leave blank to register globally (can take up to an hour to appear).
GUILD_ID=

# ---------------------------------------------------------------------------
# Optional: use a language model for replies instead of the built-in agent.
# The built-in agent always runs if this is left off, and it is fast and free.
#
# Groq (free tier, fastest): AI_BASE_URL=https://api.groq.com/openai/v1
#                            AI_MODEL=llama-3.3-70b-versatile
# OpenRouter:                AI_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama (slow on CPU): AI_ENABLED=true   (leave the key blank)
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=12000
